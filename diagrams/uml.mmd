classDiagram
    class Task {
        +str description
        +str pet_name
        +date due_date
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete() None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed, due_date) list~Task~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(task) Task
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : uses
    Scheduler ..> Task : sorts, filters, completes
